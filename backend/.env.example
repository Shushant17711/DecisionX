# DecisionX does not read provider keys from .env.
#
# Keys live in plain files next to this one, one key per line, so several keys
# can be rotated per provider. All three are optional; the app uses whichever
# are present and reports the rest as unreachable.
#
#   backend/groqapi        — runs the expert agents and the Panel Architect (required in practice)
#   backend/nvidiaapi      — synthesis fallback
#   backend/openrouterapi  — synthesis fallback of last resort
#
# All three are gitignored. Create them with, e.g.:
#   printf '%s\n' "gsk_yourkey" > backend/groqapi
#
# Optional overrides:
# DECISIONX_MAX_CONCURRENT_AGENTS=12
