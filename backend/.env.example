# DecisionX backend configuration. Copy to backend/.env and uncomment what you
# need. A real environment variable always wins over this file. Invalid values
# are logged and replaced by the default.
#
# ── Provider keys (NOT read from .env) ─────────────────────────────────────
# Keys live in plain files next to this one, one key per line, so several keys
# can be rotated per provider. All three are optional; the app uses whichever
# are present and reports the rest as unreachable. A key that returns 401/403
# is disabled for the rest of the process.
#
#   backend/groqapi        — runs the expert agents and the Panel Architect (required in practice)
#   backend/nvidiaapi      — synthesis fallback
#   backend/openrouterapi  — synthesis fallback of last resort
#
# All three are gitignored. Create them with, e.g.:
#   printf '%s\n' "gsk_yourkey" > backend/groqapi
#
# ── Network exposure ───────────────────────────────────────────────────────
# Bind address for `python main.py` and start_dev.*. Loopback by default.
# DECISIONX_HOST=127.0.0.1
# DECISIONX_PORT=8001
#
# Comma-separated. /api/evaluate* rejects (403) any request whose Origin header
# is present and not listed. Requests without an Origin (curl) are allowed.
# DECISIONX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Optional shared secret. When set, /api/evaluate* requires the header
#   X-DecisionX-Token: <value>   (401 otherwise). Set it if you bind beyond loopback.
# DECISIONX_API_TOKEN=
#
# ── Pipeline limits ────────────────────────────────────────────────────────
# Persona LLM calls in flight across ALL concurrent evaluations (1–200).
# DECISIONX_MAX_CONCURRENT_AGENTS=12
#
# Whole-evaluation deadline in seconds (10–1800). Experts still running when
# their share runs out are reported as timed out; synthesis uses what finished.
# DECISIONX_RUN_TIMEOUT=120
#
# Characters of typed context + documents each expert sees (500–100000). The
# synthesizer gets half, the Panel Architect a quarter. Typed context is never
# cut for experts/synthesis; documents share the rest (at least a quarter of
# the budget), split fairly per file.
# DECISIONX_CONTEXT_BUDGET_CHARS=6000
#
# Condense documents that do not fit their share with one shared LLM pass per
# run (a "reading" stage before the panel) instead of cutting them off. Falls
# back to cutting when the pass fails or runs out of time. true/false.
# DECISIONX_CONDENSE=true
#
# ── Upload parsing ─────────────────────────────────────────────────────────
# Per-file parse timeout in seconds (1–300).
# DECISIONX_PARSE_TIMEOUT=20
#
# "subprocess" (default): each file is parsed in a child process that is killed
# on timeout and memory-capped. "thread": in-process, faster start, cannot be killed.
# DECISIONX_PARSER_ISOLATION=subprocess
#
# Address-space cap for the parse worker in MB (128–16384; POSIX only).
# DECISIONX_PARSE_MEMORY_MB=1024
#
# ── Logging ────────────────────────────────────────────────────────────────
# DECISIONX_LOG_LEVEL=INFO
